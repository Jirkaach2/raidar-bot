[Unit]
Description=Raidar Discord Bot
After=network-online.target
Wants=network-online.target
# Never latch into a permanent "failed" state — always keep retrying. The old
# StartLimitBurst latch could leave the bot down for minutes until the cron
# watchdog ran. Restart=always + RestartSec handles crash-loops gracefully.
StartLimitIntervalSec=0

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/raidar-bot
ExecStart=/usr/bin/env node src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
# Keep the bot from starving the whole VM (sshd/OS stay responsive).
# The big killer on a ~0.5–1GB box is swap thrashing — forbid it so the bot
# gets OOM-killed/restarted instead of dragging the whole VM down.
MemoryHigh=240M
MemoryMax=320M
MemorySwapMax=512M
CPUQuota=60%
CPUWeight=20
Nice=10
# Cap Node heap so it fails fast instead of swap-thrashing.
Environment=NODE_OPTIONS=--max-old-space-size=200
# App-level guardian restarts cleanly when RSS nears the cgroup cap (must stay
# below MemoryMax so we exit before the kernel OOM-kills us).
Environment=RSS_LIMIT_MB=290
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
