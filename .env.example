# ── Discord ──────────────────────────────────────────────
# Bot token (Developer Portal → Bot). Enable "Public Bot" to let anyone invite it.
DISCORD_TOKEN=
# Application (client) ID — General Information
DISCORD_CLIENT_ID=
# Optional: register commands to ONE guild for fast testing. Leave blank for a
# public bot (commands register GLOBALLY, ~1h to propagate).
DISCORD_GUILD_ID=

# ── Public pairing web server ────────────────────────────
# Public URL where users log in with Steam to get a pairing code.
# Must be reachable from the internet and point at this bot's PAIRING_PORT.
# e.g. https://raidar.example.com  (TLS strongly recommended)
PUBLIC_BASE_URL=
PAIRING_PORT=3000

# ── Global permission fallback (per-guild settings override these) ──
# Only used if a guild hasn't configured its own role/allowlist; otherwise
# control commands fall back to server Administrators.
CONTROL_ROLE_ID=
ALLOWED_USER_IDS=
